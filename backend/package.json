{
  "name": "khau-katta-backend",
  "version": "1.0.0",
  "description": "Backend API for Khau Katta Belagavi Marketplace",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "dev": "node --env-file=.env -r ts-node/register src/server.ts",
    "migrate": "node --env-file=.env -r ts-node/register src/scripts/migrate.ts",
    "seed:auth": "node --env-file=.env -r ts-node/register src/scripts/seed-auth.ts"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
